<?xml version="1.0"?>
<ruleset name="40Q Plugins">
	<description>PHPCS configuration for 40Q plugins workspace.</description>

	<!-- Paths to scan -->
	<file>plugins/</file>

	<!-- Exclude generated/vendor files -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!-- Standards -->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
	</rule>

	<!-- PHP version target -->
	<config name="testVersion" value="8.2-"/>

	<!-- Minimum WP version — suppresses false-positives for functions
	available since the versions we support. WordPress core does NOT
	need to be present on disk; PHPCS uses its own bundled stubs. -->
	<config name="minimum_supported_wp_version" value="6.4"/>
</ruleset>
