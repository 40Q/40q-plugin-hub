{
  "name": "by40q/workspace",
  "version": "1.0.0",
  "private": true,
  "description": "40Q Agency – WordPress Plugin Workspace",
  "workspaces": [
    "plugins/by40q-core",
    "plugins/by40q-plugin-boilerplate"
  ],
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:restart": "wp-env start --update",
    "env:reset": "wp-env clean all",
    "env:destroy": "wp-env destroy",
    "env:logs": "wp-env logs",
    "build": "npm run build --workspaces --if-present",
    "build:watch": "npm run start --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present"
  },
  "devDependencies": {
    "@wordpress/env": "^10.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^6.9"
  }
}
